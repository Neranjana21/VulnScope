# Copy this file to .env (gitignored) and fill in real local-dev values.
# Never commit .env; never put a real secret in this example file.
POSTGRES_PASSWORD=changeme-dev-only
VULNSCOPE_APP_PASSWORD=changeme-dev-only-too

# App-role connection string (asyncpg), consumed by vulnscope.config.Settings.
VULNSCOPE_DATABASE_URL=postgresql+asyncpg://vulnscope_app:changeme-dev-only-too@127.0.0.1:5432/vulnscope

# Migrator-role connection string (asyncpg), consumed only by alembic/env.py.
VULNSCOPE_MIGRATION_DATABASE_URL=postgresql+asyncpg://vulnscope_migrator:changeme-dev-only@127.0.0.1:5432/vulnscope

VULNSCOPE_MAX_RPS_PER_HOST=10
VULNSCOPE_MAX_WINDOW_DAYS=90
VULNSCOPE_ENABLE_LAB=0
VULNSCOPE_LAB_CIDR=127.0.0.1/32
